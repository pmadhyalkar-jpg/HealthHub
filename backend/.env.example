# Copy to backend/.env and fill in your local configuration. Never commit backend/.env.
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthhub
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# SMTP is required to deliver verification and appointment emails.
# Without SMTP, development verification links are printed in the Flask terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_sending_email@example.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=your_sending_email@example.com

MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads_private
EMAIL_VERIFICATION_MINUTES=30
